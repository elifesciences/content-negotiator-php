{
    "name": "elife/content-negotiator",
    "description": "eLife Sciences content negotiator",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "eLife\\ContentNegotiator\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "test\\eLife\\ContentNegotiator\\": "./test"
        }
    },
    "require": {
        "php": "^8.2",
        "symfony/http-foundation": "^6.0 || ^7.0",
        "symfony/http-kernel": "^6.0 || ^7.0",
        "willdurand/negotiation": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "~12.5.0",
        "squizlabs/php_codesniffer": "^3.5",
        "symfony/error-handler": "^7.4.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
